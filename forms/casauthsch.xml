<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fields name="casauthsch">
        <fieldset
            name="casauthsch"
            label="PLG_SYSTEM_CASAUTH_SCH_USER_GROUP_LABEL"
            description="PLG_SYSTEM_CASAUTH_SCH_USER_GROUP_DESC">

            <field
                name="uid"
                type="text"
                label="PLG_SYSTEM_CASAUTH_SCH_USER_UID_LABEL"
                readonly="true"
            />

            <field
                name="mail"
                type="text"
                label="PLG_SYSTEM_CASAUTH_SCH_USER_MAIL_LABEL"
                readonly="true"
            />

            <field
                name="fullname"
                type="text"
                label="PLG_SYSTEM_CASAUTH_SCH_USER_FULLNAME_LABEL"
                readonly="true"
            />

            <field
                name="linked_at"
                type="text"
                label="PLG_SYSTEM_CASAUTH_SCH_USER_LINKED_AT_LABEL"
                readonly="true"
            />

            <field
                name="last_login_at"
                type="text"
                label="PLG_SYSTEM_CASAUTH_SCH_USER_LAST_LOGIN_AT_LABEL"
                readonly="true"
            />

            <field
                name="autolink_blocked"
                type="radio"
                label="PLG_SYSTEM_CASAUTH_SCH_USER_AUTOLINK_BLOCKED_LABEL"
                description="PLG_SYSTEM_CASAUTH_SCH_USER_AUTOLINK_BLOCKED_DESC"
                layout="joomla.form.field.radio.switcher"
                default="0">
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>

            <field
                name="clear_link"
                type="radio"
                label="PLG_SYSTEM_CASAUTH_SCH_USER_CLEAR_LINK_LABEL"
                description="PLG_SYSTEM_CASAUTH_SCH_USER_CLEAR_LINK_DESC"
                layout="joomla.form.field.radio.switcher"
                default="0">
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>
        </fieldset>
    </fields>
</form>
