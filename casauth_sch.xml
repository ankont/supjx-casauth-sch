<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade" version="5.0">
    <name>PLG_SYSTEM_CASAUTH_SCH</name>
    <author>Andreas Kontarinis &amp; ChatGPT</author>
    <creationDate>2025-09-26</creationDate>
    <version>1.3.1</version>
    <description>PLG_SYSTEM_CASAUTH_SCH_XML_DESCRIPTION</description>
    <element>casauth_sch</element>
    <namespace path="src">SuperSoft\Plugin\System\CasAuthSch</namespace>
    <files>
        <folder plugin="casauth_sch">services</folder>
        <folder>src</folder>
        <folder>forms</folder>
        <folder>language</folder>
        <folder>vendor</folder>
        <filename>README.md</filename>
        <filename>composer.json</filename>
    </files>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="auto_redirect_login" type="radio" class="btn-group btn-group-yesno" layout="joomla.form.field.radio.buttons" default="0" label="PLG_SYSTEM_CASAUTH_SCH_AUTO_REDIRECT_LOGIN" description="PLG_SYSTEM_CASAUTH_SCH_AUTO_REDIRECT_LOGIN_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="host" type="text" default="sso.sch.gr" label="PLG_SYSTEM_CASAUTH_SCH_HOST" description="PLG_SYSTEM_CASAUTH_SCH_HOST_DESC" hint="PLG_SYSTEM_CASAUTH_SCH_HOST_HINT" required="true"/>
                <field name="port" type="number" default="443" label="PLG_SYSTEM_CASAUTH_SCH_PORT" description="PLG_SYSTEM_CASAUTH_SCH_PORT_DESC" hint="PLG_SYSTEM_CASAUTH_SCH_PORT_HINT" required="true"/>
                <field name="context" type="text" default="/" label="PLG_SYSTEM_CASAUTH_SCH_CONTEXT" description="PLG_SYSTEM_CASAUTH_SCH_CONTEXT_DESC" hint="PLG_SYSTEM_CASAUTH_SCH_CONTEXT_HINT" required="true"/>
                <field name="service_url" type="text" label="PLG_SYSTEM_CASAUTH_SCH_SERVICE_URL" description="PLG_SYSTEM_CASAUTH_SCH_SERVICE_URL_DESC" hint="PLG_SYSTEM_CASAUTH_SCH_SERVICE_URL_HINT"/>
                <field name="ca_cert" type="text" label="PLG_SYSTEM_CASAUTH_SCH_CA_CERT" description="PLG_SYSTEM_CASAUTH_SCH_CA_CERT_DESC" hint="PLG_SYSTEM_CASAUTH_SCH_CA_CERT_HINT" required="true"/>
                <field name="username_attribute" type="text" label="PLG_SYSTEM_CASAUTH_SCH_USERNAME_ATTRIBUTE" description="PLG_SYSTEM_CASAUTH_SCH_USERNAME_ATTRIBUTE_DESC" hint="PLG_SYSTEM_CASAUTH_SCH_USERNAME_ATTRIBUTE_HINT"/>
                <field name="mail_attribute" type="text" label="PLG_SYSTEM_CASAUTH_SCH_MAIL_ATTRIBUTE" description="PLG_SYSTEM_CASAUTH_SCH_MAIL_ATTRIBUTE_DESC" hint="PLG_SYSTEM_CASAUTH_SCH_MAIL_ATTRIBUTE_HINT"/>
                <field name="fullname_attribute" type="text" label="PLG_SYSTEM_CASAUTH_SCH_FULLNAME_ATTRIBUTE" description="PLG_SYSTEM_CASAUTH_SCH_FULLNAME_ATTRIBUTE_DESC" hint="PLG_SYSTEM_CASAUTH_SCH_FULLNAME_ATTRIBUTE_HINT"/>
                <field name="auto_create" type="radio" class="btn-group btn-group-yesno" layout="joomla.form.field.radio.buttons" default="1" label="PLG_SYSTEM_CASAUTH_SCH_AUTO_CREATE" description="PLG_SYSTEM_CASAUTH_SCH_AUTO_CREATE_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="sync_profile" type="radio" class="btn-group btn-group-yesno" layout="joomla.form.field.radio.buttons" default="1" label="PLG_SYSTEM_CASAUTH_SCH_SYNC_PROFILE" description="PLG_SYSTEM_CASAUTH_SCH_SYNC_PROFILE_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="log_cas_attributes" type="radio" class="btn-group btn-group-yesno" layout="joomla.form.field.radio.buttons" default="0" label="PLG_SYSTEM_CASAUTH_SCH_LOG_CAS_ATTRIBUTES" description="PLG_SYSTEM_CASAUTH_SCH_LOG_CAS_ATTRIBUTES_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="default_group" type="usergrouplist" default="2" label="PLG_SYSTEM_CASAUTH_SCH_DEFAULT_GROUP" description="PLG_SYSTEM_CASAUTH_SCH_DEFAULT_GROUP_DESC"/>
                <field
                    name="umdobject_group_map"
                    type="subform"
                    label="PLG_SYSTEM_CASAUTH_SCH_UMDOBJECT_GROUP_MAP"
                    description="PLG_SYSTEM_CASAUTH_SCH_UMDOBJECT_GROUP_MAP_DESC"
                    multiple="true"
                    layout="joomla.form.field.subform.repeatable-table">
                    <form>
                        <field
                            name="umdobject"
                            type="text"
                            label="PLG_SYSTEM_CASAUTH_SCH_UMDOBJECT_GROUP_MAP_UMDOBJECT"
                            hint="PLG_SYSTEM_CASAUTH_SCH_UMDOBJECT_GROUP_MAP_UMDOBJECT_HINT"
                        />
                        <field
                            name="group_id"
                            type="usergrouplist"
                            label="PLG_SYSTEM_CASAUTH_SCH_UMDOBJECT_GROUP_MAP_GROUP"
                        />
                    </form>
                </field>
                <field name="allowed_umdobject" type="text" label="PLG_SYSTEM_CASAUTH_SCH_ALLOWED_UMDOBJECT" description="PLG_SYSTEM_CASAUTH_SCH_ALLOWED_UMDOBJECT_DESC" hint="PLG_SYSTEM_CASAUTH_SCH_ALLOWED_UMDOBJECT_HINT"/>
                <field name="allowed_business_category" type="text" label="PLG_SYSTEM_CASAUTH_SCH_ALLOWED_BUSINESS_CATEGORY" description="PLG_SYSTEM_CASAUTH_SCH_ALLOWED_BUSINESS_CATEGORY_DESC" hint="PLG_SYSTEM_CASAUTH_SCH_ALLOWED_BUSINESS_CATEGORY_HINT"/>
                <field name="unit_code_attribute" type="text" label="PLG_SYSTEM_CASAUTH_SCH_UNIT_CODE_ATTRIBUTE" description="PLG_SYSTEM_CASAUTH_SCH_UNIT_CODE_ATTRIBUTE_DESC" hint="PLG_SYSTEM_CASAUTH_SCH_UNIT_CODE_ATTRIBUTE_HINT"/>
                <field name="allowed_unit_codes" type="text" label="PLG_SYSTEM_CASAUTH_SCH_ALLOWED_UNIT_CODES" description="PLG_SYSTEM_CASAUTH_SCH_ALLOWED_UNIT_CODES_DESC" hint="PLG_SYSTEM_CASAUTH_SCH_ALLOWED_UNIT_CODES_HINT"/>
                <field name="logout_url" type="text" default="https://sso-01.sch.gr/logout" label="PLG_SYSTEM_CASAUTH_SCH_LOGOUT_URL" description="PLG_SYSTEM_CASAUTH_SCH_LOGOUT_URL_DESC" hint="PLG_SYSTEM_CASAUTH_SCH_LOGOUT_URL_HINT" required="true"/>
            </fieldset>
        </fields>
    </config>
    <languages>
        <language tag="en-GB">language/en-GB/en-GB.plg_system_casauth_sch.ini</language>
        <language tag="en-GB">language/en-GB/en-GB.plg_system_casauth_sch.sys.ini</language>
        <language tag="el-GR">language/el-GR/el-GR.plg_system_casauth_sch.ini</language>
        <language tag="el-GR">language/el-GR/el-GR.plg_system_casauth_sch.sys.ini</language>
    </languages>
</extension>
